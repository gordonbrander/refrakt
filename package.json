{
  "name": "refrakt",
  "version": "0.3.2",
  "description": "A lightweight, scalable state management library built on top of TC39 signals",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./store.js": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./signal.js": {
      "types": "./dist/signal.d.ts",
      "import": "./dist/signal.js"
    },
    "./send.js": {
      "types": "./dist/send.d.ts",
      "import": "./dist/send.js"
    },
    "./iter.js": {
      "types": "./dist/iter.d.ts",
      "import": "./dist/iter.js"
    },
    "./reducer.js": {
      "types": "./dist/reducer.d.ts",
      "import": "./dist/reducer.js"
    },
    "./scope.js": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    },
    "./never.js": {
      "types": "./dist/never.d.ts",
      "import": "./dist/never.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "README.md",
    "LICENSE-MIT"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepublishOnly": "npm run check && npm run check:examples && npm run lint && npm run check-fmt && npm run build",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "check": "tsc --noEmit",
    "check:examples": "tsc -p examples/tsconfig.json",
    "fmt": "prettier --write .",
    "lint": "eslint .",
    "check-fmt": "prettier --check ."
  },
  "keywords": [
    "signals",
    "reducer",
    "redux",
    "elm",
    "lit",
    "state",
    "reactive",
    "store",
    "immutable"
  ],
  "author": "Gordon Brander",
  "license": "MIT",
  "dependencies": {
    "signal-polyfill": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonbrander/refrakt.git"
  }
}
